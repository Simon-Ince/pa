# Copy this file to .env (git-ignored) and adjust if your paths differ.

# Host port the dashboard is exposed on (container always listens on 8000).
HOST_PORT=8420

# Read-only bind mounts of existing host files/dirs — do not point these at
# copies, the container reads the live files directly.
GOOGLE_TOKEN_PATH=/Users/simonince/.hermes/profiles/pa/google_token.json
GOOGLE_CLIENT_SECRET_PATH=/Users/simonince/.hermes/profiles/pa/google_client_secret.json
DASHBOARD_DATA_PATH=/Users/simonince/.hermes/profiles/pa/dashboard_data
TICKTICK_TOKEN_PATH=/Users/simonince/.hermes/profiles/pa/ticktick_token.json
